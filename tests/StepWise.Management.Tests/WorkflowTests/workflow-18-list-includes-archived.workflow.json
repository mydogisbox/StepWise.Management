{
  "name": "Workflow_18_ListIncludesArchived",
  "steps": [
    {
      "build": "createWorkflow",
      "with": {
        "payload": { "static": {
          "name": { "static": "archived-workflow" }
        }}
      }
    },
    { "build": "archiveWorkflow" },
    { "step": "postWorkflowCommands" },
    {
      "step": "listWorkflows",
      "query": {
        "showArchived": { "static": "true" }
      }
    }
  ],
  "assertions": [
    { "equal": ["$listWorkflows[?name=createWorkflow.payload.name].isArchived", "true"] }
  ]
}
