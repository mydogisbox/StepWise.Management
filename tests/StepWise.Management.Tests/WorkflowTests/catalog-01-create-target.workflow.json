{
  "name": "Catalog_01_CreateTarget",
  "steps": [
    {
      "build": "createTarget",
      "with": {
        "payload": { "static": {
          "name": { "static": "my-target" },
          "baseUrl": { "static": "http://localhost:5020" }
        }}
      }
    },
    { "step": "postTargetCommands" },
    { "step": "getTarget" }
  ],
  "assertions": [
    { "equal": ["$getTarget.name", "my-target"] },
    { "equal": ["$getTarget.baseUrl", "http://localhost:5020"] }
  ]
}
