{
  "name": "Execution_22_VoucherValidationWithAssertions",
  "steps": [
    { "workflow": "SetupExampleCatalog" },
    {
      "build": "upsertStep",
      "captureAs": "validateSave10Step",
      "with": {
        "payload": { "static": {
          "stepName": { "static": "validate-save10" },
          "method": { "static": "POST" },
          "path": { "static": "/vouchers/validate" },
          "defaults": { "static": {
            "code": { "static": "SAVE10" }
          }}
        }}
      }
    },
    {
      "step": "postCatalogStepCommands",
      "with": {
        "aggregateId": { "from": "validateSave10Step.payload.id" },
        "commands": { "static": [{ "from": "validateSave10Step" }] }
      }
    },
    { "build": "createWorkflow" },
    {
      "build": "appendStep",
      "captureAs": "step1",
      "with": {
        "payload": { "static": {
          "catalogStepId": { "from": "validateSave10Step.payload.id" }
        }}
      }
    },
    {
      "build": "addAssertion",
      "with": {
        "payload": { "static": {
          "assertion": { "static": {
            "equal": { "static": [{ "template": "{step1.payload.id}.valid" }, "true"] }
          }}
        }}
      }
    },
    {
      "build": "addAssertion",
      "with": {
        "payload": { "static": {
          "assertion": { "static": {
            "equal": { "static": [{ "template": "{step1.payload.id}.discountPct" }, "10"] }
          }}
        }}
      }
    },
    { "step": "postWorkflowCommands" },
    { "step": "runWorkflow" },
    {
      "poll": "getRun",
      "until": { "equal": ["$getRun.status", "completed"] },
      "intervalMs": 200,
      "timeoutMs": 10000
    }
  ],
  "assertions": [
    { "equal": ["$getRun.result.passed", "true"] },
    { "count": ["$getRun.result.steps", "1"] },
    { "empty": "$getRun.result.assertionErrors" },
    { "notEmpty": "$getRun.result.steps[?stepName=step1.payload.id].response.valid" }
  ]
}
