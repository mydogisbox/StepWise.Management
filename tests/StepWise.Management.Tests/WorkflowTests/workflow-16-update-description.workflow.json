{
  "name": "Workflow_16_UpdateDescription",
  "steps": [
    { "build": "createWorkflow" },
    {
      "build": "updateWorkflowDescription",
      "with": {
        "payload": { "static": {
          "description": { "static": "A workflow description" }
        }}
      }
    },
    { "step": "postWorkflowCommands" },
    { "step": "getWorkflow" }
  ],
  "assertions": [
    { "equal": ["$getWorkflow.description", "A workflow description"] }
  ]
}
