{
  "name": "Execution_17_CrossReference",
  "steps": [
    { "workflow": "SetupExampleCatalog" },
    { "build": "createWorkflow" },
    {
      "build": "appendStep",
      "captureAs": "step1",
      "with": {
        "payload": { "static": {
          "catalogStepId": { "from": "adminCreateProductStep.payload.id" }
        }}
      }
    },
    { "build": "appendStep" },
    {
      "build": "addAssertion",
      "with": {
        "payload": { "static": {
          "assertion": { "static": {
            "equal": { "static": [{ "template": "{appendStep.payload.id}.totalCount" }, "999"] }
          }}
        }}
      }
    },
    { "step": "postWorkflowCommands" },
    { "step": "runWorkflow" },
    {
      "poll": "getRun",
      "until": { "equal": ["$getRun.status", "completed"] },
      "intervalMs": 200,
      "timeoutMs": 10000
    }
  ],
  "assertions": [
    { "equal": ["$getRun.result.passed", "false"] },
    { "count": ["$getRun.result.steps", "2"] },
    { "single": "$getRun.result.assertionErrors" },
    { "notEmpty": "$getRun.result.steps[?stepName=step1.payload.id].response.id" },
    { "notEmpty": "$getRun.result.steps[?stepName=appendStep.payload.id].response" }
  ]
}
