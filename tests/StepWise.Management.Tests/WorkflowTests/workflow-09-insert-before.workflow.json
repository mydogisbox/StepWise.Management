{
  "name": "Workflow_09_InsertStepBefore",
  "steps": [
    { "workflow": "SetupCatalogWithStep" },
    { "build": "createWorkflow" },
    {
      "build": "appendStep",
      "captureAs": "appendedStepA",
      "with": {
        "payload": { "static": {
          "defaults": { "static": { "param": "value1" } }
        }}
      }
    },
    {
      "build": "appendStep",
      "captureAs": "appendedStepB",
      "with": {
        "payload": { "static": {
          "defaults": { "static": { "param": "value2" } }
        }}
      }
    },
    {
      "build": "insertStepBefore",
      "with": {
        "payload": { "static": {
          "beforeId": { "from": "appendedStepB.payload.id" },
          "defaults": { "static": { "param": "value3" } }
        }}
      }
    },
    { "step": "postWorkflowCommands" },
    { "step": "getWorkflow" }
  ],
  "assertions": [
    { "equal": ["getWorkflow.steps[0].id", "appendedStepA.payload.id"] },
    { "equal": ["getWorkflow.steps[0].defaults.param", "value1"] },
    { "equal": ["getWorkflow.steps[1].id", "insertStepBefore.payload.id"] },
    { "equal": ["getWorkflow.steps[1].defaults.param", "value3"] },
    { "equal": ["getWorkflow.steps[2].id", "appendedStepB.payload.id"] },
    { "equal": ["getWorkflow.steps[2].defaults.param", "value2"] }
  ]
}
