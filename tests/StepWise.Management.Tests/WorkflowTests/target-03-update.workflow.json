{
  "name": "Target_03_Update",
  "steps": [
    {
      "build": "createTarget",
      "with": {
        "payload": { "static": {
          "name": { "static": "original-name" },
          "baseUrl": { "static": "http://original.com" }
        }}
      }
    },
    {
      "build": "updateTarget",
      "with": {
        "payload": { "static": {
          "name": { "static": "updated-name" },
          "baseUrl": { "static": "http://updated.com" }
        }}
      }
    },
    { "step": "postTargetCommands" },
    { "step": "getTarget" }
  ],
  "assertions": [
    { "equal": ["$getTarget.name", "updated-name"] },
    { "equal": ["$getTarget.baseUrl", "http://updated.com"] }
  ]
}
