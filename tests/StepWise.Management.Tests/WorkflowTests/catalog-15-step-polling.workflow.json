{
  "name": "Catalog_15_StepPolling",
  "steps": [
    { "build": "createTarget" },
    { "step": "postTargetCommands" },
    { "step": "listTargets" },
    { "build": "createCatalog" },
    { "step": "postCatalogCommands" },
    { "step": "listCatalogs" },
    {
      "build": "upsertStep",
      "with": {
        "payload": { "static": {
          "isPolling": { "static": true },
          "retryCount": { "static": 3 },
          "retryDurationMs": { "static": 500 }
        }}
      }
    },
    { "step": "postCatalogStepCommands" },
    { "step": "getCatalogStep" }
  ],
  "assertions": [
    { "equal": ["$getCatalogStep.isPolling", "true"] },
    { "equal": ["$getCatalogStep.retryCount", "3"] },
    { "equal": ["$getCatalogStep.retryDurationMs", "500"] }
  ]
}
