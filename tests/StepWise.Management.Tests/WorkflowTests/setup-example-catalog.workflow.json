{
  "name": "SetupExampleCatalog",
  "steps": [
    {
      "build": "createTarget",
      "with": {
        "payload": { "static": {
          "name": { "static": "example-api" },
          "baseUrl": { "static": "http://localhost:5010" }
        }}
      }
    },
    { "step": "postTargetCommands" },
    { "step": "listTargets" },
    {
      "build": "createCatalog",
      "with": {
        "payload": { "static": {
          "name": { "static": "example-api-catalog" }
        }}
      }
    },
    { "step": "postCatalogCommands" },
    { "step": "listCatalogs" },
    { "workflow": "SetupAdminCreateProductStep" },
    {
      "build": "upsertStep",
      "with": {
        "payload": { "static": {
          "stepName": { "static": "list-products" },
          "method": { "static": "GET" },
          "path": { "static": "/products" }
        }}
      }
    },
    {
      "step": "postCatalogStepCommands",
      "with": {
        "commands": { "static": [{ "from": "upsertStep" }] }
      }
    },
    { "step": "listCatalogSteps" }
  ]
}
