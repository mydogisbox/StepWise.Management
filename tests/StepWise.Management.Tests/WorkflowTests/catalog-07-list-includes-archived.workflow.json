{
  "name": "Catalog_07_ListIncludesArchived",
  "steps": [
    { "build": "createTarget" },
    { "step": "postTargetCommands" },
    { "step": "listTargets" },
    { "build": "createCatalog" },
    { "step": "postCatalogCommands" },
    { "step": "listCatalogs" },
    {
      "build": "upsertStep",
      "with": {
        "payload": { "static": {
          "stepName": { "static": "archivedStep" }
        }}
      }
    },
    { "build": "archiveStep" },
    { "step": "postCatalogStepCommands" },
    {
      "step": "listCatalogSteps",
      "query": {
        "showArchived": { "static": "true" }
      }
    }
  ],
  "assertions": [
    { "count": ["listCatalogSteps", "1"] },
    { "equal": ["listCatalogSteps[0].stepName", "archivedStep"] }
  ]
}
