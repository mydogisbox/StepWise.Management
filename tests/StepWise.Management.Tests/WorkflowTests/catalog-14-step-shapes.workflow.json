{
  "name": "Catalog_14_StepShapes",
  "steps": [
    { "build": "createTarget" },
    { "step": "postTargetCommands" },
    { "step": "listTargets" },
    { "build": "createCatalog" },
    { "step": "postCatalogCommands" },
    { "step": "listCatalogs" },
    {
      "build": "upsertStep",
      "with": {
        "payload": { "static": {
          "requestShape": { "static": { "kind": "request" } },
          "responseShape": { "static": { "kind": "response" } }
        }}
      }
    },
    { "step": "postCatalogStepCommands" },
    { "step": "getCatalogStep" }
  ],
  "assertions": [
    { "equal": ["$getCatalogStep.requestShape.kind", "request"] },
    { "equal": ["$getCatalogStep.responseShape.kind", "response"] }
  ]
}
