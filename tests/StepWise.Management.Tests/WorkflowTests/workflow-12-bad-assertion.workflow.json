{
  "name": "Workflow_12_BadAssertion",
  "steps": [
    { "workflow": "SetupCatalogWithStep" },
    { "build": "createWorkflow" },
    { "build": "appendStep" },
    {
      "build": "addAssertion",
      "with": {
        "payload": { "static": {
          "assertion": { "static": {
            "equal": { "static": ["nonExistentStep.id", "appendStep.payload.id"] }
          }}
        }}
      }
    },
    { "step": "postWorkflowCommands", "captureRequestAs": "workflowReq" },
    { "step": "getWorkflow" }
  ],
  "assertions": [
    { "count": ["getWorkflow.assertions", "1"] }
  ]
}
