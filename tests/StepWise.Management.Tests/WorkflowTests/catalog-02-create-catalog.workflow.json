{
  "name": "Catalog_02_Create",
  "steps": [
    {
      "build": "createCatalog",
      "with": {
        "payload": { "static": {
          "name": { "static": "My Catalog" }
        }}
      }
    },
    { "step": "postCatalogCommands" },
    { "step": "getCatalog" }
  ],
  "assertions": [
    { "equal": ["$getCatalog.name", "My Catalog"] }
  ]
}
