{
  "name": "Catalog_09_SuccessCapturesStatus",
  "steps": [
    { "build": "createTarget" },
    { "step": "postTargetCommands" },
    { "step": "listTargets" },
    { "build": "createCatalog" },
    { "step": "postCatalogCommands" },
    { "build": "upsertStep" },
    { "step": "postCatalogStepCommands", "captureFullResponseAs": "successResponse" }
  ],
  "assertions": [
    { "equal": ["$successResponse.status", "200"] },
    { "notEmpty": "$successResponse.body" }
  ]
}
