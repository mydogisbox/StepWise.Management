{
  "name": "SetupAdminCreateProductStep",
  "steps": [
    {
      "build": "upsertStep",
      "captureAs": "adminCreateProductStep",
      "with": {
        "payload": { "static": {
          "stepName": { "static": "admin-create-product" },
          "method": { "static": "POST" },
          "path": { "static": "/admin/products" },
          "headers": { "static": {
            "X-Admin-Key": { "static": "admin-secret" }
          }},
          "defaults": { "static": {
            "name": { "generated": "guid" },
            "category": { "static": "electronics" },
            "price": { "static": 9.99 },
            "stock": { "static": 10 }
          }}
        }}
      }
    },
    {
      "step": "postCatalogStepCommands",
      "with": {
        "aggregateId": { "from": "adminCreateProductStep.payload.id" },
        "commands": { "static": [{ "from": "adminCreateProductStep" }] }
      }
    }
  ]
}
