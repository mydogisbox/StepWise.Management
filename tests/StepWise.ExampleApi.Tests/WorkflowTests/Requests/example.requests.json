{
  "steps": {
    "adminCreateUser": {
      "target": "example",
      "method": "POST",
      "path": "/admin/users",
      "headers": {
        "X-Admin-Key": { "static": "admin-secret" }
      },
      "defaults": {
        "email": { "generated": "email" },
        "password": { "static": "password" },
        "name": { "generated": "guid" }
      }
    },
    "adminCreateProduct": {
      "target": "example",
      "method": "POST",
      "path": "/admin/products",
      "headers": {
        "X-Admin-Key": { "static": "admin-secret" }
      },
      "defaults": {
        "id": { "generated": "guid" },
        "name": { "generated": "guid" },
        "category": { "static": "electronics" },
        "price": { "static": 9.99 },
        "stock": { "static": 10 },
        "description": { "static": "" }
      }
    },
    "adminSetStock": {
      "target": "example",
      "method": "PATCH",
      "path": "/admin/products/{id}/stock",
      "headers": {
        "X-Admin-Key": { "static": "admin-secret" }
      },
      "pathParams": {
        "id": { "from": "adminCreateProduct.id" }
      },
      "defaults": {
        "stock": { "static": 0 }
      }
    },
    "adminCreateVoucher": {
      "target": "example",
      "method": "POST",
      "path": "/admin/vouchers",
      "headers": {
        "X-Admin-Key": { "static": "admin-secret" }
      },
      "defaults": {
        "code": { "generated": "guid" },
        "discountPct": { "static": 10 }
      }
    },
    "login": {
      "target": "example",
      "method": "POST",
      "path": "/auth/login",
      "defaults": {
        "email": { "from": "adminCreateUser.email" },
        "password": { "static": "password" }
      }
    },
    "listProducts": {
      "target": "example",
      "method": "GET",
      "path": "/products"
    },
    "getProduct": {
      "target": "example",
      "method": "GET",
      "path": "/products/{id}",
      "pathParams": {
        "id": { "from": "adminCreateProduct.id" }
      }
    },
    "addToCart": {
      "target": "example",
      "method": "POST",
      "path": "/cart/items",
      "headers": {
        "Authorization": { "template": "Bearer {login.token}" }
      },
      "defaults": {
        "productId": { "from": "adminCreateProduct.id" },
        "quantity": { "static": 1 }
      }
    },
    "getCart": {
      "target": "example",
      "method": "GET",
      "path": "/cart",
      "headers": {
        "Authorization": { "template": "Bearer {login.token}" }
      }
    },
    "placeOrder": {
      "target": "example",
      "method": "POST",
      "path": "/orders",
      "headers": {
        "Authorization": { "template": "Bearer {login.token}" }
      },
      "defaults": {}
    },
    "getOrder": {
      "target": "example",
      "method": "GET",
      "path": "/orders/{id}",
      "headers": {
        "Authorization": { "template": "Bearer {login.token}" }
      },
      "pathParams": {
        "id": { "from": "placeOrder.id" }
      }
    },
    "cancelOrder": {
      "target": "example",
      "method": "POST",
      "path": "/orders/{id}/cancel",
      "headers": {
        "Authorization": { "template": "Bearer {login.token}" }
      },
      "pathParams": {
        "id": { "from": "placeOrder.id" }
      }
    },
    "validateVoucher": {
      "target": "example",
      "method": "POST",
      "path": "/vouchers/validate",
      "defaults": {
        "code": { "from": "adminCreateVoucher.code", "default": { "static": "" } }
      }
    }
  }
}
